 "components": {
  "schemas": {
   "ApplyChange": {
    "properties": {
     "by": {
      "type": "string",
      "minLength": 1,
      "title": "By"
     },
     "change": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/RuleChange"
       },
       {
        "type": "null"
       }
      ]
     },
     "text": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Text",
      "description": "A whole new rules.yaml, for manual editing"
     },
     "source": {
      "type": "string",
      "title": "Source",
      "default": "manual"
     },
     "request_text": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Request Text"
     }
    },
    "type": "object",
    "required": [
     "by"
    ],
    "title": "ApplyChange"
   },
   "BuyRequest": {
    "properties": {
     "text": {
      "type": "string",
      "title": "Text",
      "examples": [
       "I need 1,000 litres of lactose-free milk by Monday."
      ]
     },
     "scenario": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Scenario",
      "description": "Demo only: 'split' uses simulated stock"
     }
    },
    "type": "object",
    "required": [
     "text"
    ],
    "title": "BuyRequest"
   },
   "BuyerAnswer": {
    "properties": {
     "confirm": {
      "type": "boolean",
      "title": "Confirm",
      "default": false
     },
     "new_amount": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "New Amount"
     }
    },
    "type": "object",
    "title": "BuyerAnswer"
   },
   "Decision": {
    "properties": {
     "decision": {
      "type": "string",
      "pattern": "^(approve|reject)$",
      "title": "Decision"
     },
     "by": {
      "type": "string",
      "minLength": 1,
      "title": "By",
      "examples": [
       "kitchen manager"
      ]
     }
    },
    "type": "object",
    "required": [
     "decision",
     "by"
    ],
    "title": "Decision"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "OrderLine": {
    "properties": {
     "product_id": {
      "type": "string",
      "title": "Product Id"
     },
     "quantity": {
      "type": "number",
      "title": "Quantity"
     },
     "price_per_unit_with_tax": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Price Per Unit With Tax"
     }
    },
    "type": "object",
    "required": [
     "product_id",
     "quantity"
    ],
    "title": "OrderLine"
   },
   "OrderRequest": {
    "properties": {
     "lines": {
      "items": {
       "$ref": "#/components/schemas/OrderLine"
      },
      "type": "array",
      "title": "Lines"
     },
     "delivery_date": {
      "type": "string",
      "title": "Delivery Date"
     },
     "placed_by": {
      "type": "string",
      "title": "Placed By",
      "default": "agent"
     },
     "request_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Request Id"
     },
     "note": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Note"
     }
    },
    "type": "object",
    "required": [
     "lines",
     "delivery_date"
    ],
    "title": "OrderRequest"
   },
   "PreviewChange": {
    "properties": {
     "change": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/RuleChange"
       },
       {
        "type": "null"
       }
      ]
     },
     "text": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Text"
     }
    },
    "type": "object",
    "title": "PreviewChange"
