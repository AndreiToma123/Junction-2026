# Copy this file to ".env" and fill in the keys. ".env" is never put in git.
AIMO_API_KEY=put-your-key-here
# Google Gemini key (from https://aistudio.google.com/apikey). Optional: without it the app
# runs in "simple mode" using plain-code fallbacks. Restart the backend after adding it.
GEMINI_API_KEY=put-your-key-here
# Optional: which Gemini model to use (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
